# Peaster (Pester) live-test inputs - the full environment-variable contract.
#
# Usage: copy this file to tests/peaster/.env and fill in your tenant's values.
# .env is gitignored; never commit real ids, passwords, or secrets.
#
# Precedence: real environment variables > .env > $PeasterEnvDefaults (PeasterConfig.ps1).
# An empty/missing value means the corresponding live test auto-skips.
# Note: everything after '=' is the value - do not add comments on value lines.

# --- Core (Stage-16 SP cert / Stage-19 TAP) ---------------------------------

# Live tenant id (GUID); empty = skip live tests
ARM_TENANT_ID=
# Alternative tenant id source
AZURE_TENANT_ID=
# Pfx password; must match scripts/stage-16/init.ps1
CERT_PFX_PASSWORD=Workshop123!
# UPN or object id to issue a TAP for; empty = skip TAP test
TAP_TARGET_USER=
# Requested TAP lifetime (10-43200)
TAP_LIFETIME_MINUTES=60

# --- External-01 - Native Authentication email-OTP sign-up ------------------
# (External-01.NativeAuth-SignUp.E2E.Tests.ps1 / External-01.NativeAuth-SignIn.E2E.Tests.ps1)

# External CIAM subdomain (e.g. contoso); empty = skip the live signup/federation tests
NATIVE_AUTH_TENANT_SUBDOMAIN=
# OTP mailbox domain; empty = skip
NATIVE_AUTH_EMAIL_DOMAIN=
# Fakemail RSS base URL; feed = <base>/<email>; empty = skip
NATIVE_AUTH_RSS_BASE=
# Optional override; else terraform output external_native_federation_client_id
NATIVE_AUTH_CLIENT_ID=
# Sign-IN username; optional override, else terraform output external_native_signin_user_email
NATIVE_AUTH_SIGNIN_USERNAME=
# Sign-IN password; MUST match the native_auth_test_user module password
NATIVE_AUTH_SIGNIN_PASSWORD=Aa1!Workshop-Native-External-01
# Seconds to poll the RSS feed for the OTP mail (sign-up email verification)
NATIVE_AUTH_OTP_TIMEOUT_SEC=90
# External tenant id for post-test user cleanup (empty = leave user)
EXTERNAL_GRAPH_TENANT_ID=
# App-only client id for cleanup (needs User.ReadWrite.All)
EXTERNAL_GRAPH_CLIENT_ID=
# App-only client secret for cleanup
EXTERNAL_GRAPH_CLIENT_SECRET=

# --- External-02 - Federation with Entra Workforce ID -----------------------
# (External-02.FederationWithEntra.Simple.Tests.ps1)

# External CIAM tenant id (GUID); optional override, else terraform output external_tenant_id (external_tenant dir)
EXTERNAL_TENANT_ID=
# client_id for the authorize request; optional override, else terraform output external_native_federation_client_id (external_tenant dir)
FEDERATION_WORKFORCE_CLIENT_ID=
# Workforce tenant verified domain for domain_hint (e.g. contoso.onmicrosoft.com); empty = skip domain_hint test
WORKFORCE_FEDERATION_DOMAIN_NAME=
